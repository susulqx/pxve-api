# 端口（仅本地 local-server.ts 使用，Vercel 忽略）
PORT=3021

# [实验性] 是否启用 API GET 请求缓存, 1开启 0关闭，缓存位置为系统临时目录( /tmp 或者 %TEMP% )
# Vercel Node 运行时无 Cache API，1 时中间件自动降级为空操作
ENABLE_CACHE=0

# 请求来源域名白名单，不限制的话留空
ACCEPT_DOMAINS="localhost,example1.com,example2.com"
# 请求来源 User-Agent 黑名单，不限制的话留空
UA_BLACKLIST="curl,bot,got,python,java,request,http,scan,inspect,netcraft"
# User-Agent 机器人检测方案: aua(默认, @arraypress/user-agent) | isbot | no(关闭检测)
# 未设置或非法值 → 告警并降级为 aua
USER_AGENT_DETECTOR="aua"
